{
  "manifest_version": 2,
  "name": "MyPass",
  "version": "0.8.0",
  "description": "Fill logins from the MyPass password manager, without the clipboard.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mypass@staldal.nu",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "menus"
  ],
  "optional_permissions": [
    "webRequest",
    "webRequestBlocking",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["auth-permissions.js", "background.js"],
    "persistent": true
  },
  "icons": {
    "16": "icons/mypass16.png",
    "32": "icons/mypass32.png",
    "48": "icons/mypass48.png",
    "96": "icons/mypass96.png"
  },
  "browser_action": {
    "default_title": "Fill login with MyPass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/mypass16.png",
      "32": "icons/mypass32.png",
      "48": "icons/mypass48.png",
      "96": "icons/mypass96.png"
    }
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+L"
      },
      "description": "Fill login with MyPass"
    }
  }
}
