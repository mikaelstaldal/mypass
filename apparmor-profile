#include <tunables/global>

profile MyPass ${PATH_TO_EXECUTABLE}/mypass {
    #include <abstractions/base>

    ${PATH_TO_EXECUTABLE}/mypass rm,

    /dev/tty rw, # read password

    # X11 clipboard access
    network unix,
    owner /run/user/@{uid}/gdm/Xauthority r,

    # Wayland clipboard access
    owner /run/user/@{uid}/.mutter-Xwaylandauth* r,

    owner @{HOME}/ r,
    owner @{HOME}/mypass.scrypt rwk,
    owner @{HOME}/mypass.scrypt.bak rwk,
    owner @{HOME}/mypass.scrypt.tmp rwk,

    owner @{HOME}/.config/mypass/ r,
    owner @{HOME}/.config/mypass/* rw,
}
